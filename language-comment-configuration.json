{
  "comments": { "lineComment": "//" },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "`", "close": "`" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"],
    ["*", "*"],
    ["_", "_"],
    ["~", "~"]
  ],
  "wordPattern": "@?[A-Za-z_][A-Za-z0-9_]*",
  "onEnterRules": [
    { "beforeText": "^\\s*\\/#(?!\\/).*$", "action": { "indent": "none", "appendText": "/# " } },
    { "beforeText": "^\\s*\\/\\|.*$", "action": { "indent": "none", "appendText": "/| " } }
  ]
}
