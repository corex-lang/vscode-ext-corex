{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ],
  "colorizedBracketPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoCloseBefore": ";:.,=}])> \n\t",
  "wordPattern": "@?[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^(?:(?!//).)*(?:\\{[^}{\"'`/]*(?:/(?!/)[^}{\"'`/]*)*|\\([^)()\"'`/]*(?:/(?!/)[^)()\"'`/]*)*|\\[[^\\]\\[\"'`/]*(?:/(?!/)[^\\]\\[\"'`/]*)*|=>\\s*)(?://.*)?$",
    "decreaseIndentPattern": "^\\s*[\\})\\]]"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*\\/#(?!\\/).*$",
      "action": { "indent": "none", "appendText": "/# " }
    },
    {
      "beforeText": "^\\s*\\/\\|.*$",
      "action": { "indent": "none", "appendText": "/| " }
    },
    {
      "beforeText": "^(?:(?!//).)*\\{\\s*$",
      "afterText": "^\\s*\\}",
      "action": { "indent": "indentOutdent" }
    },
    {
      "beforeText": "^(?:(?!//).)*\\[\\s*$",
      "afterText": "^\\s*\\]",
      "action": { "indent": "indentOutdent" }
    },
    {
      "beforeText": "^(?:(?!//).)*\\(\\s*$",
      "afterText": "^\\s*\\)",
      "action": { "indent": "indentOutdent" }
    },
    {
      "beforeText": "(?:\\b(?:f|b?r)#*|\\bb)?\"$",
      "afterText": "^\\s*\"#*",
      "action": { "indent": "none" }
    }
  ],
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*//\\s*#?region\\b",
      "end": "^\\s*//\\s*#?endregion\\b"
    }
  }
}
